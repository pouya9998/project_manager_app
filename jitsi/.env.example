# Jitsi Meet (docker-jitsi-meet) — local / PMO defaults
# Start: docker compose -f jitsi/docker-compose.yml --env-file jitsi/.env up -d
# On a real server set PUBLIC_URL and JVB_ADVERTISE_IPS to your public host.

# Relative to this compose file directory (jitsi/)
CONFIG=./jitsi-cfg
HTTP_PORT=8091
HTTPS_PORT=8443
TZ=Asia/Tehran

# Browser-facing URL.
# Local only: http://localhost:8091 + DISABLE_HTTPS=1 is fine.
# Remote users: browsers block WebRTC on http://IP — use self-signed HTTPS (no domain needed):
#   PUBLIC_URL=https://YOUR_PUBLIC_IP:8443
#   DISABLE_HTTPS=0
#   ENABLE_LETSENCRYPT=0
# Later with a domain: PUBLIC_URL=https://meet.example.com + nginx TLS + DISABLE_HTTPS=1
PUBLIC_URL=http://localhost:8091
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0
ENABLE_WELCOME_PAGE=0
ENABLE_GUESTS=1
ENABLE_PREJOIN_PAGE=1
ENABLE_AUTH=0

# Media: set to the IP clients can reach (LAN or public). Required behind NAT/VPN.
# Example: JVB_ADVERTISE_IPS=192.168.1.10
JVB_ADVERTISE_IPS=192.168.130.249
JVB_PORT=10000
# Avoid clash with HTTP_PORT / other apps on 8080
JVB_COLIBRI_PORT=8089
JICOFO_REST_PORT=8889

RESTART_POLICY=unless-stopped
JITSI_IMAGE_VERSION=stable

# XMPP service passwords (dev — regenerate for production)
JICOFO_AUTH_PASSWORD=46f9ce2dc50238dfa90daacbc181b4e2
JVB_AUTH_PASSWORD=cb56d17fae9525dc78b7eb2d6acad7ca
JIGASI_XMPP_PASSWORD=a252622a0211291a144aa325402c2164
JIGASI_TRANSCRIBER_PASSWORD=aeaada8a783172661bf6e566846e7d50
JIBRI_RECORDER_PASSWORD=86aa3574a2fab725449d34f68c6b88d0
JIBRI_XMPP_PASSWORD=d49af4b3c9caa9f11973b268dd896c93

XMPP_DOMAIN=meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi
XMPP_BOSH_URL_BASE=http://xmpp.meet.jitsi:5280
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
JVB_BREWERY_MUC=jvbbrewery
JICOFO_AUTH_USER=focus
JVB_AUTH_USER=jvb
ENABLE_XMPP_WEBSOCKET=1
ENABLE_COLIBRI_WEBSOCKET=1
